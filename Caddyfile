# Serve a SPA estática. Railway injeta a porta via $PORT.
{
	admin off
}

:{$PORT:80} {
	root * /srv
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		# SAMEORIGIN, não DENY: o showroom abre a maquete 3D (/showroom/...) num iframe da mesma origem.
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# Os links são pessoais, enviados pelo WhatsApp: não indexar.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	try_files {path} /index.html
	file_server
}
